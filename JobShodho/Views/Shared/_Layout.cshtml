<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobShodho</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="topbar navbar navbar-expand">
        <div class="container-fluid">
            <button class="btn btn-link text-white d-md-none" id="sidebarToggle" type="button" aria-label="Toggle navigation">
                <span class="bi">&#9776;</span>
            </button>
            <a class="navbar-brand fw-semibold" asp-controller="Dashboard" asp-action="Index">JobShodho</a>
            <span class="ms-auto text-white-50 small d-none d-sm-inline">AI Job Application Manager</span>
        </div>
    </nav>

    <div class="app-shell">
        <aside class="sidebar" id="appSidebar">
            <nav class="nav flex-column">
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a class="nav-link" asp-controller="Jobs" asp-action="Index">Jobs</a>
                <a class="nav-link" asp-controller="Import" asp-action="Index">Import Jobs</a>
                <a class="nav-link" asp-controller="Email" asp-action="Queue">Email Queue</a>
                <a class="nav-link" asp-controller="Resume" asp-action="Index">Resumes</a>
                <a class="nav-link" asp-controller="Email" asp-action="History">Email History</a>
                <a class="nav-link" asp-controller="Settings" asp-action="Index">Settings</a>
            </nav>
        </aside>

        <main class="content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
