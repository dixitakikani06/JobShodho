@model List<EmailSendLog>
@{
    ViewData["Title"] = "Email History";
    var page = (int)ViewData["Page"]!;
    var totalPages = (int)ViewData["TotalPages"]!;
}

<h4 class="mb-3">Email History</h4>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Email</th>
                        <th>Subject</th>
                        <th>Attempt</th>
                        <th>Status</th>
                        <th>Sent At</th>
                        <th>Error</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td>@(log.JobApplication?.CompanyName ?? "—")</td>
                            <td>@log.RecipientEmail</td>
                            <td>@log.Subject</td>
                            <td>@log.AttemptNumber</td>
                            <td>
                                @if (log.Status == EmailLogStatus.Sent)
                                {
                                    <span class="badge badge-status-sent">Sent</span>
                                }
                                else
                                {
                                    <span class="badge badge-status-failed">Failed</span>
                                }
                            </td>
                            <td>@(log.SentAt?.ToLocalTime().ToString("dd MMM HH:mm") ?? "—")</td>
                            <td class="text-danger small">@log.ErrorMessage</td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No email attempts logged yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination pagination-sm">
                    @for (var p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == page ? "active" : "")">
                            <a class="page-link" asp-action="History" asp-route-page="@p">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>
