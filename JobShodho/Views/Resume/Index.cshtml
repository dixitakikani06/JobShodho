@model List<Resume>
@{
    ViewData["Title"] = "Resumes";
}

<h4 class="mb-3">Resume Management</h4>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h6 class="section-title">Upload Resume</h6>
                <form asp-controller="Resume" asp-action="Upload" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label">Resume Name</label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. .NET Developer - 4yrs" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">File (PDF or DOCX)</label>
                        <input type="file" name="file" class="form-control" accept=".pdf,.docx" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Upload</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <h6 class="section-title">Uploaded Resumes</h6>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>File</th>
                                <th>Size</th>
                                <th>Active</th>
                                <th>Uploaded</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var resume in Model)
                            {
                                <tr>
                                    <td>@resume.Name</td>
                                    <td>@resume.OriginalFileName</td>
                                    <td>@((resume.FileSizeBytes / 1024.0).ToString("N0")) KB</td>
                                    <td>
                                        @if (resume.IsActive)
                                        {
                                            <span class="badge badge-status-sent">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-status-pending">Inactive</span>
                                        }
                                    </td>
                                    <td>@resume.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                    <td class="text-nowrap">
                                        <a asp-action="Download" asp-route-id="@resume.Id" class="btn btn-sm btn-outline-primary">Download</a>
                                        <form asp-action="ToggleActive" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@resume.Id" />
                                            <input type="hidden" name="isActive" value="@(!resume.IsActive)" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">@(resume.IsActive ? "Deactivate" : "Activate")</button>
                                        </form>
                                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this resume?');">
                                            <input type="hidden" name="id" value="@resume.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (Model.Count == 0)
                            {
                                <tr><td colspan="6" class="text-center text-muted py-4">No resumes uploaded yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
