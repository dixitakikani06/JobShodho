@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Dashboard</h4>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value">@Model.TotalJobs</div>
            <div class="stat-label">Total Jobs</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value">@Model.Pending</div>
            <div class="stat-label">Pending</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value">@Model.ReadyForReview</div>
            <div class="stat-label">Ready for Review</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value">@Model.Sent</div>
            <div class="stat-label">Sent</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value text-danger">@Model.Failed</div>
            <div class="stat-label">Failed</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value text-success">@Model.SentToday</div>
            <div class="stat-label">Sent Today</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value text-danger">@Model.FailedToday</div>
            <div class="stat-label">Failed Today</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-value">@Model.RemainingToSend</div>
            <div class="stat-label">Remaining</div>
        </div>
    </div>
</div>

<div class="mb-4 d-flex gap-2">
    <a asp-controller="Jobs" asp-action="Index" class="btn btn-outline-primary">Generate Pending AI Content</a>
    <a asp-controller="Email" asp-action="Queue" class="btn btn-primary">Send Next 10</a>
    <a asp-controller="Import" asp-action="Index" class="btn btn-outline-primary">Import Jobs</a>
</div>

<div class="card">
    <div class="card-body">
        <h6 class="section-title">Recent Applications</h6>
        @if (Model.RecentApplications.Count == 0)
        {
            <p class="text-muted mb-0">No job applications yet. Start by importing jobs from Excel.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Company</th>
                            <th>Job Title</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Resume</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model.RecentApplications)
                        {
                            <tr>
                                <td>@job.CompanyName</td>
                                <td>@job.JobTitle</td>
                                <td>@job.RecipientEmail</td>
                                <td><partial name="_StatusBadge" model="job.EmailStatus" /></td>
                                <td>@(job.SelectedResume?.Name ?? "—")</td>
                                <td>@job.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td><a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="btn btn-sm btn-outline-primary">View</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
